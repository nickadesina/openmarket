{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "*.ts",
      "!!.impeccable",
      "!next-env.d.ts",
      // Generated fixtures: their generators own the bytes, and the ingest must reproduce event-flags.json exactly.
      "!tests/fixtures"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "css": { "formatter": { "enabled": true }, "linter": { "enabled": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Ratchet: the threshold sits just above where new code should stop.
        // Existing functions above it carry a biome-ignore naming the debt;
        // lower this number as they are split.
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 25 }
        },
        // Module CSS outranks its own cascade with scoped selectors, never !important.
        "noImportantStyles": "error"
      },
      "style": {
        // Module stylesheets group a control's states next to its base rule; the cascade order is intentional and local.
        "noDescendingSpecificity": "off",
        // noUncheckedIndexedAccess also flags validated engine vectors, test fixtures,
        // service query results, and UI arrays/query values guarded before use. Keep
        // assertions available across those layers; their owners audit the guards.
        "noNonNullAssertion": "off"
      },
      "a11y": {
        // Segmented controls are divs with role=group; fieldset would fight the plate layout.
        "useSemanticElements": "off"
      }
    }
  },
  "overrides": [
    {
      // The reduced-motion reset must beat every animation declaration in the app.
      "includes": ["src/app/globals.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    },
    {
      // Tests read top-to-bottom as scenarios; a higher ceiling keeps them in one place.
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 40 }
            }
          }
        }
      }
    }
  ]
}
