{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm exec -- tsx --env-file-if-exists=.env.local scripts/vercel-build.ts",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "23 7 * * *"
    }
  ]
}
