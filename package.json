{
  "name": "openmarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "test:browser:local": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "db:test:local": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --test-local",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit:styles": "tsx --env-file-if-exists=.env.local scripts/audit-styles.ts",
    "audit:deps": "tsx --env-file-if-exists=.env.local scripts/audit-deps.ts",
    "check": "npm run typecheck && npm run lint && npm run audit:styles && npm run audit:deps",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "deploy:check": "tsx --env-file-if-exists=.env.local scripts/verify-production-config.ts --target=production",
    "deploy:check:preview": "tsx --env-file-if-exists=.env.local scripts/verify-production-config.ts --target=preview",
    "export:objections": "tsx scripts/export-objections.ts",
    "export:resolution-sources": "tsx scripts/export-resolution-sources.ts",
    "export:round-history": "tsx scripts/export-round-history.ts",
    "api-key:create": "tsx --env-file-if-exists=.env.local scripts/api-key-create.ts",
    "export:tradeables": "npm run export:resolution-sources && npm run export:round-history",
    "index:watchlist": "tsx --env-file-if-exists=.env.local scripts/index-watchlist.ts",
    "index:search": "tsx --env-file-if-exists=.env.local scripts/index-search.ts",
    "index:ingest": "tsx --env-file-if-exists=.env.local scripts/index-ingest.ts",
    "index:families": "tsx --env-file-if-exists=.env.local scripts/index-families.ts",
    "index:relabel": "tsx --env-file-if-exists=.env.local scripts/index-relabel.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fast-check": "^4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "kysely": "^0.29.5",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  }
}
