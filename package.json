{
  "name": "openmarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "test:browser:local": "DATABASE_URL_TEST=postgresql://$USER@localhost:5432/openmarket_test playwright test",
    "db:test:local": "createdb openmarket_test 2>/dev/null; DATABASE_URL_UNPOOLED=postgresql://$USER@localhost:5432/openmarket_test DATABASE_URL=postgresql://$USER@localhost:5432/openmarket_test tsx scripts/migrate.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit:styles": "tsx scripts/audit-styles.ts",
    "audit:deps": "tsx scripts/audit-deps.ts",
    "check": "npm run typecheck && npm run lint && npm run audit:styles && npm run audit:deps",
    "db:migrate": "tsx scripts/migrate.ts",
    "verify:replay": "tsx scripts/verify-replay.ts",
    "deploy:check": "tsx scripts/verify-production-config.ts --target=production",
    "deploy:check:preview": "tsx scripts/verify-production-config.ts --target=preview",
    "seed:production": "tsx scripts/production-seed.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "reseed:dev": "tsx scripts/reseed-dev.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fast-check": "^4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.102.8",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "kysely": "^0.29.5",
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  }
}
