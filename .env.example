# OpenMarket environment contract — names only. Never commit secret values.
#
# Vercel Project Settings must select Node.js 22.x. Production and every preview
# must be connected to different Neon branches. The Neon/Vercel integration must
# inject both URLs from the branch assigned to that deployment.

# Runtime route pools only. Must be a Neon `-pooler` PostgreSQL URL with
# `sslmode=require`.
DATABASE_URL=

# Direct operations only (migrations, listings, replay diagnostics).
# Must be the matching non-pooler Neon URL with `sslmode=require`.
DATABASE_URL_UNPOOLED=

# Tests only (CI, `npm run test:integration`, `npm run test:browser:local`).
# Point at a disposable PostgreSQL 17 database; never production.
DATABASE_URL_TEST=

# Deployment/branch guards. Set NEON_BRANCH_ROLE to `production` or `preview`.
# NEON_BRANCH_ID identifies the assigned branch. PRODUCTION_NEON_BRANCH_ID and
# PRODUCTION_DATABASE_HOST are non-secret production identifiers used to prove
# that preview builds cannot migrate the production branch. The host is the
# direct hostname only (for example, an `ep-…neon.tech` host), never a URL.
NEON_BRANCH_ROLE=
NEON_BRANCH_ID=
PRODUCTION_NEON_BRANCH_ID=
PRODUCTION_DATABASE_HOST=

# Canonical public production origin only: HTTPS scheme and host, with no path,
# query, fragment, credentials, or trailing application route. Vercel preview
# origins are additionally derived at request time from VERCEL_URL and
# VERCEL_BRANCH_URL; do not hard-code preview domains here.
APP_ORIGIN=

# Tournament sign-in is the only identity (README D1, D9). X OAuth 2.0 needs
# X_CLIENT_ID (and X_CLIENT_SECRET for a confidential client); the callback is
# ${APP_ORIGIN}/api/t/auth/x/callback unless X_REDIRECT_URI overrides it.
# Without them only username/password accounts can sign in.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Admins of /admin and /t/admin: numeric X ids, `password:<username>`, or
# `dev:<handle>` (local only), comma separated.
TOURNAMENT_ADMIN_X_IDS=

# Local `next dev` only: `1` adds a handle-only sign-in. Ignored in every other mode.
TOURNAMENT_DEV_SIGN_IN=

# `1` gives every listed instrument a linked tournament question (the bridge,
# README D9). Unset, the tournament asks only its own launch questions.
TOURNAMENT_LINKED_QUESTIONS=

# Bearer secret for /api/cron/dealer, /api/cron/settle and /api/t/cron/provenance
# (at least 16 characters). Vercel Cron sends it automatically. Production
# builds require it. Set the same value in GitHub only for dealer-alerts.yml;
# scheduled non-fork alerts fail without it, while manual/fork alerts skip.
CRON_SECRET=

# Tournament provenance (README D9). The fee wallet: the 64-byte solana-keygen
# JSON array, or its base58. Without it, Merkle roots are committed and shown
# but not posted. SOLANA_CLUSTER is `mainnet-beta` (default) or `devnet`;
# SOLANA_RPC_URL overrides the cluster's public endpoint.
SOLANA_PROVENANCE_SECRET_KEY=
SOLANA_CLUSTER=
SOLANA_RPC_URL=

# Browser tests only: overrides the origin Playwright serves on (an http origin
# with a port; AGENTS.md → Local traps).
PLAYWRIGHT_APP_ORIGIN=
