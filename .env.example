# OpenMarket environment contract — names only. Never commit secret values.
#
# Vercel Project Settings must select Node.js 22.x. Production and every preview
# must be connected to different Neon branches. The Neon/Vercel integration must
# inject both URLs from the branch assigned to that deployment.

# Runtime route pools only. Must be a Neon `-pooler` PostgreSQL URL with
# `sslmode=require`.
DATABASE_URL=

# Direct operations only (migrations, production seed, replay diagnostics).
# Must be the matching non-pooler Neon URL with `sslmode=require`.
DATABASE_URL_UNPOOLED=

# CI only. Point at a disposable PostgreSQL 17 database; never production.
DATABASE_URL_TEST=

# Deployment/branch guards. Set NEON_BRANCH_ROLE to `production` or `preview`.
# NEON_BRANCH_ID identifies the assigned branch. PRODUCTION_NEON_BRANCH_ID and
# PRODUCTION_DATABASE_HOST are non-secret production identifiers used to prove
# that preview builds cannot migrate the production branch. The host is the
# direct hostname only (for example, an `ep-…neon.tech` host), never a URL.
NEON_BRANCH_ROLE=
NEON_BRANCH_ID=
PRODUCTION_NEON_BRANCH_ID=
PRODUCTION_DATABASE_HOST=

# Canonical public production origin only: HTTPS scheme and host, with no path,
# query, fragment, credentials, or trailing application route. Vercel preview
# origins are additionally derived at request time from VERCEL_URL and
# VERCEL_BRANCH_URL; do not hard-code preview domains here.
APP_ORIGIN=

# Distinct canonical base64url strings, each decoding to at least 32 random
# bytes. Generate outside the repository and configure separately by Vercel
# environment scope.
USER_COOKIE_SECRET=
ADMIN_COOKIE_SECRET=

# Exact format: scrypt$16384$8$1$<16-byte-base64url-salt>$<64-byte-base64url-key>.
# Generate with `npm run admin:hash` (hidden prompt; prints both this file's
# escaped form and the raw form for Vercel). Store only the hash.
ADMIN_PASSPHRASE_HASH=

# Production seed input is deliberately blank. Supply a JSON array only for an
# explicit production seed invocation. It must contain exactly Stripe and
# Anthropic records shaped as:
# [{"verification_status":"verified","source":{"title":"…","url":"https://…","published_date":"YYYY-MM-DD","verified_at":"ISO-8601 timestamp"},"seed":{"name":"…","slug":"stripe|anthropic","logo_path":"…","metric_kind":"valuation_median","anchor_valuation_usd":"…","anchor_date":"YYYY-MM-DD","anchor_description":"…","b":0,"sigma":0}}]
# Values must come from current, manually verified public sources. Draft anchors
# in src/lib/config/seed-markets.ts are development-only and are always refused.
PRODUCTION_SEED_MARKETS_JSON=
